\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Composite ranking under six weight regimes (10-scale, ranked within the ten reported pipelines). The MF/Agg and MICE/KM columns show each pipeline's rank in that regime, where $1$ is best and $10$ is worst. In every regime the four strong imputed pipelines occupy the top four ranks. The identity of the top-ranked pipeline depends on the balance-versus-separation trade-off.}}{5}{table.1}\protected@file@percent }
\newlabel{tbl:weight_sens}{{I}{5}{Composite ranking under six weight regimes (10-scale, ranked within the ten reported pipelines). The MF/Agg and MICE/KM columns show each pipeline's rank in that regime, where $1$ is best and $10$ is worst. In every regime the four strong imputed pipelines occupy the top four ranks. The identity of the top-ranked pipeline depends on the balance-versus-separation trade-off}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Composite cluster-validity score for the ten pipelines (MF: MissForest). Imputed pipelines (blue) occupy the top, but the Agglomerative pipelines using MICE and KNN collapse among the no-imputation baselines (grey). The benefit of imputation is conditional on the combination of imputer and clustering algorithm. ``None40/None20'' denote the no-imputation baselines that drop columns above $40\%$ or $20\%$ missingness.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:ranking}{{3}{5}{Composite cluster-validity score for the ten pipelines (MF: MissForest). Imputed pipelines (blue) occupy the top, but the Agglomerative pipelines using MICE and KNN collapse among the no-imputation baselines (grey). The benefit of imputation is conditional on the combination of imputer and clustering algorithm. ``None40/None20'' denote the no-imputation baselines that drop columns above $40\%$ or $20\%$ missingness}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}Imputation Helps, but the Combination Matters}{5}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Per-pipeline results ordered by composite (10-scale). $K$ is the tuned cluster count; \emph  {Largest \%} is the share of the largest cluster (an inverse balance signal: $\sim 50\%$ is well split, $\sim 100\%$ is a mega-cluster with orphans). The four strong imputed pipelines give clean $k{=}2$ partitions with silhouette above $0.75$; the other six either collapse or over-segment.}}{5}{table.2}\protected@file@percent }
\newlabel{tbl:results}{{II}{5}{Per-pipeline results ordered by composite (10-scale). $K$ is the tuned cluster count; \emph {Largest \%} is the share of the largest cluster (an inverse balance signal: $\sim 50\%$ is well split, $\sim 100\%$ is a mega-cluster with orphans). The four strong imputed pipelines give clean $k{=}2$ partitions with silhouette above $0.75$; the other six either collapse or over-segment}{table.2}{}}
